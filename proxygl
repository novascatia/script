function startSpamThread()
    if spam_thread_running then return end 
    spam_thread_running = true
    runThread(function()
        while SPAM.ENABLE do
            if SPAM.TEXT ~= "" then
                sendPacket(2, "action|input\n|text|" .. SPAM.TEXT)
            end
            local delay = tonumber(SPAM.DELAY) or 4
            if delay < 0.1 then delay = 0.1 end
            sleep(delay * 1000)
            
            if not SPAM.ENABLE then break end
        end
        spam_thread_running = false
    end)
end

local function start_skin_cycle()
    if skin_thread_running then return end
    skin_thread_running = true
    
    runThread(function()
        local index = 1
        
        while is_cycling do
            sendPacket(2, skins[index])
            
            index = index + 1
            if index > #skins then
                index = 1
            end
            
            sleep(1000)
        end
        
        skin_thread_running = false
    end)
end

