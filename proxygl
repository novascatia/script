function OnSendPacket(type, packet)
    if type == 2 and packet:find("action|input") then
        local text = packet:match("text|(.+)")
        if text then
            if text:sub(1,1) == "/" then
                local command, params = text:match("^/(%S+)%s*(.*)")
                if command and cmd[command] then
                    cmd[command].func(params)
                    return true 
                end
            elseif rainbowchat then
                local new_text = rainbow(text)
                sendPacket(2, "action|input\n|text|" .. new_text)
                return true 
            end
        end
    end
    
    if type == 2 and packet:find("action|dialog_return") then
        if packet:find("nov4spam_setconfig") then
            if SPAM.ENABLE then console('Stop spam first'); return true end
            SPAM.TEXT = packet:match("nov4spam_message|(.-)\n")
            SPAM.DELAY = packet:match("nov4spam_delay|(%d+)")
            dialogspam()
            return true
        elseif packet:find("nov4spam_setup") then
            if SPAM.TEXT == "" or (tonumber(SPAM.DELAY) or 0) == 0 then
                console("Set msg & delay first")
                return true
            end
            SPAM.ENABLE = not SPAM.ENABLE
            dialogspam()
            if SPAM.ENABLE then startSpamThread() end
            return true
        elseif packet:find("wm_save_config") then
            local b_col = packet:match("wm_bracket_col|(.-)\n") or "9"
            local t_col = packet:match("wm_text_col|(.-)\n") or "4"
            wm_config.color_bracket = b_col:find("`") and b_col or "`" .. b_col
            wm_config.color_text = t_col:find("`") and t_col or "`" .. t_col
            wm_config.text = packet:match("wm_name_val|(.-)\n") or "Dexterity"
            
            console("Watermark updated!")
            return true
        elseif packet:find("set_mode_reme") then
            spin_mode = "REME"
            console("`2Spin mode set to REME``")
            return true
        elseif packet:find("set_mode_leme") then
            spin_mode = "LEME"
            console("`2Spin mode set to LEME``")
            return true
        elseif packet:find("set_mode_qeme") then
            spin_mode = "QEME"
            console("`2Spin mode set to QEME``")
            return true
        elseif packet:find("set_mode_off") then
            spin_mode = "OFF"
            console("`4Spin mode turned OFF``")
            return true
        end
    end
    return false
end

function OnSendPacketRaw(a)
    if tpdisplay then
        if a.type == 3 and a.value == 18 then
            for _, tile in pairs(getTiles()) do
                if tile.fg == 1422 or tile.fg == 2488 then
                    if tile.x == a.px and tile.y == a.py then
                        findPath(tile.x, tile.y)
                        return true 
                    end
                end
            end
        end
    end

    if take_enabled and a.type == 3 then
        local tile_x, tile_y = a.px, a.py
        for _, obj in pairs(getObjectList()) do
            local obj_tile_x = math.floor(obj.pos.x / 32)
            local obj_tile_y = math.floor(obj.pos.y / 32)
            if obj_tile_x == tile_x and obj_tile_y == tile_y then
                if obj.itemid == 242 or obj.itemid == 1796 or obj.itemid == 7188 then
                    sendPacketRaw(false, {
                        type = 11,
                        value = obj.id,
                        x = obj.pos.x,
                        y = obj.pos.y
                    })
                    return true
                end
            end
        end
    end

    return false
end

function calculateReme(n)
    local sum = 0
    local s = tostring(n)
    for i = 1, #s do sum = sum + tonumber(s:sub(i, i)) end
    return sum % 10
end

local TARGET_LOCK_NAMES = { ["World Lock"] = true, ["Diamond Lock"] = true, ["Blue Gem Lock"] = true, ["`bAbsolute Lock"] = true }

function OnVariant(var)
    local fn = var.v1
    if fn == "OnConsoleMessage" and var.v2 then
        local message = var.v2
        local count, item_name_raw = string.match(message, 'Collected `w(%d+) (.-)``')
        if count and item_name_raw then
            local item_name = item_name_raw:gsub("%. Rarity: `w%d+", "")
            item_name = item_name:match("(.+)%s*$") or item_name
            if TARGET_LOCK_NAMES[item_name] then
                local notification_message = get_full_wm() .. " Collected `2" .. count .. " `5" .. item_name
                sendPacket(2, "action|input\n|text|" .. notification_message)
                return true
            end
        end
    end

    if fn == "OnTalkBubble" and var.v3 and var.v3:find("spun the wheel and got") then
        local num = tonumber(string.match(var.v3:gsub("`.", ""), "(%d+)%!"))
        local netid = var.v2
        local pname = getPlayerNameByNetID(netid):gsub("%[.-%]", "")
        
        if spin_mode == "OFF" then
            -- MENGIRIM KEMBALI PACKET ASLI SECARA MANUAL AGAR TETAP CEPAT --
            sendVariant({v1 = "OnNameChanged", v2 = pname}, nil, netid) -- Revert nama agar tag lamanya hilang
            sendVariant({v1 = "OnTalkBubble", v2 = netid, v3 = var.v3, v4 = var.v4}) -- Kirim bubble kosong aslinya
            
            table.insert(logspin, {
                spin = string.format("add_label_with_icon|small|[%s] %s : %s|left|758|\n", os.date("%H:%M:%S", os.time()), pname:gsub(" ", ""), num),
                world = getCurrentWorldName()
            })
            return true -- Block packet game asli, pakai yang sudah dipantulkan via variant
        else
            local result_val = 0
            if spin_mode == "REME" or spin_mode == "LEME" then
                result_val = calculateReme(num)
            elseif spin_mode == "QEME" then
                result_val = num % 10
            end
            
            sendVariant({v1 = "OnNameChanged", v2 = pname .. "[`1 " .. spin_mode .. " : " .. tostring(result_val) .. "`` ]"}, nil, netid)
            sendVariant({v1 = "OnTalkBubble", v2 = netid, v3 = var.v3 .. " `9[`4" .. spin_mode .. " : `9" .. tostring(result_val) .. "```9]", v4 = var.v4})
            
            table.insert(logspin, {
                spin = string.format("add_label_with_icon|small|[%s] %s : %s (`w%s %s``)|left|758|\n", os.date("%H:%M:%S", os.time()), pname:gsub(" ", ""), num, spin_mode, result_val),
                world = getCurrentWorldName()
            })
            return true
        end
    end

    if fn == "OnDialogRequest" and var.v2 then
        local content = var.v2
        if auto_door_toggle and content:find("add_checkbox|checkbox_public|Usable by public") then
            local tilex, tiley = content:match("embed_data|tilex|(%d+)"), content:match("embed_data|tiley|(%d+)")
            local currentState = content:match("add_checkbox|checkbox_public|Usable by public|(%d)")
            if tilex and tiley and currentState then
                local newState, logMsg = "0", "`4Locked"
                if currentState == "0" then newState, logMsg = "1", "`2Unlocked" end
                sendPacket(2, "action|dialog_return\ndialog_name|switch_edit\ntilex|" .. tilex .. "|\ntiley|" .. tiley .. "|\ncheckbox_public|" .. newState)
                console("Door " .. logMsg .. ".")
            end
            return true
        end

        if pullwrench and content:find("add_button|pull|") then
            local wealth_line = content:match("add_smalltext|`wWealth:``(.-)|left|")
            local bgl_count = 0
            if wealth_line then
                local bgl_str = wealth_line:match("`w(%d+) `eBGL``")
                if bgl_str then bgl_count = tonumber(bgl_str) end
            end
            local player_name = content:match("add_label_with_icon|big|`0(.-)`w%(`2") or "Unknown"
            if bgl_count >= min_bgl_pull then
                local netid = content:match("embed_data|netID|(%d+)")
                if netid then
                    console(string.format("Pulling %s (`2%d BGL``)", player_name, bgl_count))
                    pull(tonumber(netid))
                    return true
                end
            else
                console(string.format("Ignoring %s (`4%d BGL`` < `2%d BGL``)", player_name, bgl_count, min_bgl_pull))
                return true
            end
        end

        if content:find("phonecall") and getinv(1796) >= 100 then
            local tilex, tiley = content:match("tilex|(%d+)"), content:match("tiley|(%d+)")
            if tilex and tiley then getBgl(tilex, tiley) end
            return true
        end
    end
    return false
end

