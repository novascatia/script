local NOTIFIER_ITEM_NAMES = { [242] = "World Lock", [1796] = "Diamond Lock", [7188] = "Blue Gem Lock", [17862] = "`bAbsolute Lock" }

function drop(id, count, facing, x, y)
    local current_inv = getinv(id)
    if current_inv < count then
        console("`4Failed: `0You only have `2" .. current_inv .. " `0of " .. (NOTIFIER_ITEM_NAMES[id] or "that item") .. "!")
        return 
    end

    state(facing, x, y)
    local p = string.format("action|dialog_return\ndialog_name|drop_item\nitemID|%d|\ncount|%d", id, count)
    sendPacket(2, p)
    
    local item_name = NOTIFIER_ITEM_NAMES[id]
    if item_name then
        local message = get_full_wm() .. " Dropped `2" .. count .. " `5" .. item_name
        sendPacket(2, "action|input\n|text|" .. message)
    end
end

function cdrop(amount, facing, x, y)
    if amount > lockbalance() then
        return console("Insufficient balance", 1)
    end
    local bgl = (amount >= 10000) and (math.floor(amount / 10000)) or 0
    local dl = (amount >= 100) and (math.floor(amount % 10000 / 100)) or 0
    local wl = (amount >= 1) and (math.floor(((amount % 10000) % 100))) or 0
    
    if wl > 0 then drop(242, wl, facing, x, y) end
    if dl > 0 then drop(1796, dl, facing, x, y) end
    if bgl > 0 then drop(7188, bgl, facing, x, y) end
end

